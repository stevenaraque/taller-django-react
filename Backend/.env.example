# ==============================================================================
# .env.example - PLANTILLA para el archivo .env (no tiene datos reales)
#
# El taller NO lee la clave de la base de datos del codigo: settings.py
# carga este archivo automaticamente gracias a python-dotenv
# (Mini 1 · La Boveda).
#
# Instrucciones (Mini 1):
#   1. Copia este archivo a uno nuevo llamado `.env` (sin "example").
#   2. Reemplaza cada TODO por tus valores reales de LOCAL.
#   3. NO subas el archivo .env a git (ya esta en .gitignore).
# ==============================================================================

# --- Llave de seguridad de Django (secret, privada) ---
# Genera una propia con: python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY = TODO_GENERA_UNA_CLAVE_SECRETA

# --- Modo desarrollo (True) / produccion (False) ---
DEBUG = True

# --- Bóveda: PostgreSQL 18 ---
DB_NAME = TODO_NOMBRE_DE_LA_BD          # ej: taller_django_react
DB_USER = TODO_USUARIO_DE_POSTGRES      # ej: postgres
DB_PASSWORD = TODO_CLAVE_DE_POSTGRES    # tu clave local de postgres; NUNCA la subas al repositorio
DB_HOST = localhost
DB_PORT = 5432
